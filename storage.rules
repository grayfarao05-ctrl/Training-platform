rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        firestore.exists(/databases/ai-studio-051dde94-820b-4509-9197-5fcb33f887a2/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/ai-studio-051dde94-820b-4509-9197-5fcb33f887a2/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidContentType() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType.matches('text/.*')
        || request.resource.contentType.matches('application/(msword|vnd\\.ms-.*|vnd\\.openxmlformats-officedocument\\..*)');
    }

    // Regular students may only write to their own user_uploads folder
    match /user_uploads/{uid}/{file} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
                              request.resource.size < 10 * 1024 * 1024 &&
                              isValidContentType();
      allow delete: if isOwner(uid);
    }

    // Resources: Authenticated read; only admins may upload or modify
    match /resources/{file} {
      allow get, list: if isAuthenticated();
      allow create: if isAdmin() &&
                      request.resource.size < 25 * 1024 * 1024 &&
                      isValidContentType();
      allow update, delete: if isAdmin();
    }

    match /resources/{course}/{file} {
      allow get, list: if isAuthenticated();
      allow create: if isAdmin() &&
                      request.resource.size < 25 * 1024 * 1024 &&
                      isValidContentType();
      allow update, delete: if isAdmin();
    }

    // Course Content PDFs:
    // Listing is strictly blocked so students cannot browse or enumerate the folder.
    // Direct GET is allowed with the unguessable 32-character token path for authenticated users.
    // Upload/Delete restricted to admin only.
    match /course_content/{uid}/{file} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create, update: if isAdmin() &&
                              request.resource.size < 30 * 1024 * 1024 &&
                              (request.resource.contentType == 'application/pdf' || 
                               request.resource.contentType.matches('(?i).*pdf.*') || 
                               request.resource.contentType == 'application/octet-stream');
      allow delete: if isAdmin();
    }

    // Question Images:
    // Any signed-in user can get; list is denied;
    // create or update only by admin, image content types only (jpeg/png/webp), under 2 MB;
    // delete by admin only.
    match /question_images/{uid}/{file} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create, update: if isAdmin() &&
                              request.resource.size <= 2 * 1024 * 1024 &&
                              (request.resource.contentType.matches('(?i)image/(jpeg|jpg|png|webp).*') || request.resource.contentType.matches('image/.*'));
      allow delete: if isAdmin();
    }

    // Landing Assets & Student Photos:
    // Publicly readable for landing page presentation; upload/manage by admin only
    match /landing/{file} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin() &&
                              request.resource.size <= 5 * 1024 * 1024 &&
                              request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
